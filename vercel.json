{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "www.gevix.in" }], "destination": "https://gevix.in/", "permanent": true },
    { "source": "/:path+", "has": [{ "type": "host", "value": "www.gevix.in" }], "destination": "https://gevix.in/:path+", "permanent": true },
    { "source": "/", "has": [{ "type": "host", "value": "gevix-ashen.vercel.app" }], "destination": "https://gevix.in/", "permanent": true },
    { "source": "/:path+", "has": [{ "type": "host", "value": "gevix-ashen.vercel.app" }], "destination": "https://gevix.in/:path+", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
    ]}
  ]
}
